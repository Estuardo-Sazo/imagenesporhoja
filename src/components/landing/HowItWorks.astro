---
/**
 * Los pasos van numerados porque aquí el orden sí es información:
 * es una secuencia real que la persona recorre de principio a fin.
 */
const steps = [
  {
    title: 'Carga las imágenes',
    text: 'Arrástralas a la página o elige una carpeta entera. Puedes reordenarlas arrastrando las miniaturas y girar las que salieron de lado.',
  },
  {
    title: 'Di cuántas van por hoja',
    text: 'Escribe el número. Ajusta tamaño de papel, orientación, márgenes y separación si lo necesitas.',
  },
  {
    title: 'Revisa el pliego',
    text: 'Ves la hoja tal como saldrá impresa, a escala real y con los márgenes marcados. Cambia cualquier cosa y se recalcula al instante.',
  },
  {
    title: 'Imprime o descarga',
    text: 'Manda a imprimir, guarda un PDF desde el diálogo de impresión o baja un documento de Word con todo ya acomodado.',
  },
];
---

<section class="section" id="como-funciona">
  <div class="wrap">
    <div class="section-head">
      <p class="tag">Cómo funciona</p>
      <h2>Cuatro pasos y ni una imagen movida a mano</h2>
      <p class="lead">De la carpeta a la impresora en menos de un minuto, aunque sean cien fotos.</p>
    </div>

    <ol class="steps">
      {
        steps.map((step, index) => (
          <li class="step">
            <span class="step-no">{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>

    <aside class="engine">
      <p class="tag tag--cyan">Por dentro</p>
      <h3>No es una cuadrícula fija</h3>
      <p>
        El programa prueba <strong>todas las formas posibles</strong> de repartir tus imágenes en
        filas respetando el orden que elegiste. Para cada reparto calcula qué altura tendría cada
        fila al ocupar el ancho completo de la hoja, y se queda con la combinación que cubre más
        superficie sin deformar nada.
      </p>
      <p>
        Por eso, con fotos verticales y horizontales mezcladas puede armar una fila de tres y dos de
        dos, en lugar de obligarte a una cuadrícula de 3 × 3 llena de huecos. Un control de
        equilibrio evita el extremo contrario: que una salga enorme y las demás diminutas.
      </p>
    </aside>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    border-top: 1.5px solid var(--ink);
  }

  .step {
    padding: 1.4rem 1.5rem 1.6rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .step + .step { border-left: 1px solid var(--rule); padding-left: 1.5rem; }

  .step-no {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--magenta);
    margin-bottom: 0.9rem;
  }
  .step h3 { margin-bottom: 0.35rem; }
  .step p { font-size: 0.92rem; line-height: 1.55; color: var(--ink-mid); }

  .engine {
    margin-top: clamp(2.5rem, 5vw, 3.75rem);
    max-width: 44rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--paper-2);
    border-left: 2px solid var(--cyan);
  }
  .engine h3 { margin-bottom: 0.6rem; }
  .engine p { color: var(--ink-mid); font-size: 0.95rem; }
  .engine p + p { margin-top: 0.85rem; }
  .engine strong { color: var(--ink); }

  @media (max-width: 620px) {
    .step,
    .step + .step { padding-left: 0; border-left: 0; }
  }
</style>
