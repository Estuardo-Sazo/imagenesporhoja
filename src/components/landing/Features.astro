---
const features = [
  {
    title: 'El número de imágenes lo eliges tú',
    text: 'De 1 a 40 por hoja. La herramienta se encarga de que quepan todas, sin excepción.',
  },
  {
    title: 'Márgenes al milímetro',
    text: 'Define arriba, abajo, izquierda y derecha por separado, en centímetros. Se respetan exactamente, tanto al imprimir como en el Word.',
  },
  {
    title: 'Nunca deforma tus fotos',
    text: 'Cada imagen conserva su proporción original. Si prefieres que llenen todo el espacio, puedes activar el recorte automático.',
  },
  {
    title: 'Mezcla verticales y horizontales',
    text: 'El acomodo se adapta a las proporciones reales de cada imagen, no al revés.',
  },
  {
    title: 'Carta, A4, oficio y más',
    text: 'Tamaños de papel comunes en vertical u horizontal, con la vista previa a escala real.',
  },
  {
    title: 'Salida a PDF y a Word',
    text: 'Imprime directo, guarda el PDF o descarga un .docx editable por si necesitas agregar títulos o pies de foto.',
  },
  {
    title: 'Todo pasa en tu navegador',
    text: 'No hay servidor que reciba tus archivos ni cuenta que crear. Funciona incluso si se te cae el internet a medias.',
  },
  {
    title: 'Ligera y rápida',
    text: 'Pensada para computadoras modestas y conexiones lentas, como las de un cibercafé.',
  },
];
---

<section class="section" id="caracteristicas">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Características</span>
      <h2>Lo que resuelve, en corto</h2>
    </div>
    <div class="cards">
      {
        features.map((feature) => (
          <article class="card">
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
