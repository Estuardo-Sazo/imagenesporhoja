---
import { NAV_LINKS, SITE } from '../../lib/config/site';
const path = Astro.url.pathname;
const isHome = path === '/' || path === '';
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </span>
      <span class="brand-name">{SITE.name}</span>
    </a>

    <nav aria-label="Secciones">
      {isHome && NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <a class="btn btn--sm" href="/herramienta">Usar la herramienta</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .bar { display: flex; align-items: center; gap: 1.75rem; min-height: 4rem; }

  .brand { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; }

  /* La marca es un pliego en miniatura: cuatro imágenes en una hoja. */
  .brand-mark {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1.1fr 0.9fr;
    gap: 1.5px;
    width: 17px;
    height: 22px;
    padding: 1.5px;
    border: 1px solid var(--ink);
  }
  .brand-mark span { background: var(--ink); }
  .brand-mark span:nth-child(3) { background: var(--magenta); }

  .brand-name {
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 700;
    font-size: 0.98rem;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  nav { display: flex; gap: 1.5rem; }
  nav a {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--ink-mid);
    text-decoration: none;
  }
  nav a:hover { color: var(--magenta); }

  .btn { margin-inline-start: auto; }

  @media (max-width: 820px) {
    nav { display: none; }
  }
</style>
